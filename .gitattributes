# Normalise text files and keep deterministic line endings in this repository.
* text=auto

# Source and content files should use LF.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Binary files (no line-ending normalisation).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
